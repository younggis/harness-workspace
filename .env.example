# ---------------------------------------------------------------------------
# Copy to .env.local and fill in secrets. NEVER commit .env.local.
# Compose consumes this file via `docker compose --env-file .env.local`.
# Only the variables each service needs are injected (see compose.yaml).
# ---------------------------------------------------------------------------
APP_ENV=development
INSTALLATION_ID=harness-local-dev
# Public browser origins (loopback dev). Host-only cookies, no Domain.
PORTAL_ORIGIN=http://portal.localhost:8080
WORKSPACE_HOST_SUFFIX=.localhost:8080

# Existing Windows PostgreSQL (postgis database). Only harness schema is touched.
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DATABASE=postgis
PG_SCHEMA=harness
PG_APP_USER=harness_app
PG_APP_PASSWORD=
PG_MIGRATION_USER=harness_owner
PG_MIGRATION_PASSWORD=
PG_LLM_USER=harness_llm
PG_LLM_PASSWORD=
# Schema used by the isolated test suite (never harness).
PG_TEST_SCHEMA=harness_test
PG_TEST_APP_USER=harness_test_app
PG_TEST_APP_PASSWORD=

# DeepSeek (real key only injected into the llm service at runtime)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
REASONING_EFFORT=high
THINKING_ENABLED=true

# Platform-generated signing keys (init-local.ps1 fills these if blank).
RELAY_SIGNING_KEY=
SESSION_SIGNING_KEY=

# Pinned upstream release (see upstream.lock.json). Do not change without contract tests.
DSH_VERSION=0.2.2-rc.4
DSH_NPM_PACKAGE=@deepseek-ai/dsh

# Edge published port (loopback only).
EDGE_PORT=8080

# Compose project name (kept isolated from other local projects).
COMPOSE_PROJECT_NAME=harness-local-dev
